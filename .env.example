# Domínio onde o sistema vai rodar (ex.: financas.meurumodiario.com.br)
DOMAIN=financas.seudominio.com.br

# Gere com: openssl rand -hex 24   (use só letras e números)
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-longo

# Porta local (127.0.0.1) usada pelo seu proxy reverso, se não usar o Caddy do compose
APP_PORT=3010

# Depois de criar sua conta, mantenha false. Coloque true para liberar mais cadastros (ex.: esposa).
ALLOW_SIGNUP=false

# Coloque false só se for acessar sem HTTPS (não recomendado)
COOKIE_SECURE=true

APP_TIMEZONE=America/Sao_Paulo

# Opcional: IA para entender notificações que as regras não reconhecem
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Só se a VPS já tiver um Nginx em container (veja docker-compose.proxy.yml) ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
# PROXY_NETWORK=nome_da_rede_do_nginx
